# Copy to .env, enter your key, then run scripts/start-traced-api.ps1.
# For manual startup: uv run --env-file .env --extra voice uvicorn chat_api:app --host 127.0.0.1 --port 8010
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
RECEPTIONIST_TURN_WORKERS=1
RECEPTIONIST_QUEUE_LIMIT=6
RECEPTIONIST_QUEUE_WAIT_SECONDS=30
RAG_MIN_SIMILARITY=0.62
# Optional: set LANGSMITH_ENDPOINT for your workspace's region or self-hosted endpoint.

OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=192
# RECEPTIONIST_MODEL can select an evaluated local model.

# Exact Agent ID from LangSmith Overview, not the display name.
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=local

# Developer inputs/outputs; use summary to omit content.
LANGSMITH_PAYLOAD_MODE=developer
